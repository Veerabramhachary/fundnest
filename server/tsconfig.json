{
    "compilerOptions": {
        "target": "es2024",
        "module": "es2022",
        "rootDir": "src",
        "outDir": "./dist",
        "sourceMap": true,
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck":  true,
        "allowSyntheticDefaultImports": true
    },
    "include": ["src"]
}